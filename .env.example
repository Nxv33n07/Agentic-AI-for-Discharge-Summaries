# ── Frontend (Next.js) ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Backend (FastAPI + Agent) ───────────────────────────────────────────

# Fast, Free Demo Mode (Bypasses API limits, loads pre-computed traces)
# MOCK_LLM=1

# Get a free Groq API key at: https://console.groq.com (no credit card required)
# 14,400 requests/day free. Uses Llama 3.3 70B.
GROQ_API_KEY=your_groq_api_key_here

# Alternative: OpenRouter (also free tier available)
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: override the default model per provider.
# OpenRouter models need the `provider/model` slug.
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Groq models use bare names.
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: Alternative paid provider
# OPENAI_API_KEY=your_openai_api_key_here

# Pacing between LLM calls (helps stay under free-tier per-minute rate limits)
# LLM_PACING_SECONDS=1